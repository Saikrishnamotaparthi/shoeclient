PORT=5000
FRONTEND_URL=http://localhost:5173

# Firebase Config (Env Variables — no JSON file needed)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Key\n-----END PRIVATE KEY-----\n"

# Razorpay Config
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=secret_placeholder
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

# Delhivery Config
DELHIVERY_API_TOKEN=delivery_token_placeholder

# Shadowfax Config
SHADOWFAX_API_KEY=your_shadowfax_api_key
# Staging: https://dale.staging.shadowfax.in/api
# Production: https://dale.shadowfax.in/api
SHADOWFAX_BASE_URL=https://dale.staging.shadowfax.in/api

# Email Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="SoleVault <noreply@solevault.com>"